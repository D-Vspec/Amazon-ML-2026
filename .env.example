# Pipeline configuration example. Copy to .env and edit (main.py falls back to this file if .env is missing).
# A real environment variable with the same name overrides a value.

# Where the challenge dataset was unzipped.
DATA_DIR=6ab10eb3b23ba_student_resource/student_resource/dataset

# The training data is split into N_SETS equal sets (docs/data_splits.md), written to data/splits/<N>_sets/.
N_SETS=10

# Which data to run on:
#   SETS=0 or SETS=0,1,2  -> those training sets (created automatically if missing)
#   SETS=                 -> the full SPLIT below
SETS=0
SPLIT=train

# Rows per source file, for quick runs. Empty = all rows.
NROWS=

# Implementation of each stage, by name (see the registries in main.py).
TRANSLITERATOR=anyascii
NORMALIZER=rules
BLOCKER=tfidf

# Candidates kept per S1 record by the blocker.
BLOCK_K=20

# cuda = use the GPU when one is available (falls back to cpu otherwise).
DEVICE=cuda
