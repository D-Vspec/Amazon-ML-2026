# Pipeline configuration example. Copy to .env and edit (main.py falls back to this file if .env is missing).
# A real environment variable with the same name overrides a value.

# Where the challenge dataset was unzipped.
DATA_DIR=6ab10eb3b23ba_student_resource/student_resource/dataset

# The training data is split into N_SETS equal sets (docs/data_splits.md), written to data/splits/<N>_sets/.
N_SETS=10

# Which data to run on:
#   SETS=0 or SETS=0,1,2  -> those training sets (created automatically if missing)
#   SETS=                 -> the full SPLIT below
SETS=0
SPLIT=train

# Rows per source file, for quick runs. Empty = all rows.
NROWS=

# Implementation of each stage, by name (see the registries in main.py).
TRANSLITERATOR=anyascii
NORMALIZER=rules
# BLOCKER is tfidf, embedding, or a union joined with "+" (e.g. tfidf+embedding).
BLOCKER=tfidf+embedding

# Candidates kept per S1 record by each blocker (a union keeps up to this many from each member).
BLOCK_K=20

# cuda = use the GPU when one is available (falls back to cpu otherwise).
DEVICE=cuda

# Sentence-transformers model for the embedding blocker; it reads the raw, untransliterated text.
EMBED_MODEL=intfloat/multilingual-e5-small

# Matcher: scores each candidate pair; empty = stop after blocking. It trains on TRAIN_SETS, picks the
# decision threshold on TUNE_SETS, and is scored (F0.5) on SETS. All three must be different sets.
MATCHER=xgb
TRAIN_SETS=1
TUNE_SETS=2
# A saved matcher file: if it exists it is loaded instead of training (TRAIN_SETS unused); if it doesn't,
# the matcher is trained on TRAIN_SETS and saved there.
MATCHER_MODEL=

# Cross-encoder (docs/matching.md): a Hub base checkpoint, empty = off. Its fine-tuned copy lives in
# CE_MODEL_DIR: loaded if it exists, otherwise fine-tuned on CE_TRAIN_SETS (a set no other role uses) and saved.
# Its probability becomes the score_cross_encoder feature for XGBoost.
CROSS_ENCODER=
CE_TRAIN_SETS=
CE_MODEL_DIR=

# Cache of blocking + featurizing output per set (parquet), reused while the settings that shape it are
# unchanged; empty = off. Delete the folder after changing blocker/featurizer code.
CACHE_DIR=data/cache
